<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.casdap.Player">
    <method name="SetScreenOff">
      <arg name="off" type="b" direction="in"/>
    </method>
    <method name="ShowPowerMenu"/>
    <method name="ShowOverlay"/>
    <method name="HideOverlay"/>
    <method name="ToggleOverlay"/>
    <method name="ShowSwitchPrompt"/>
    <property name="ScreenOff" type="b" access="read"/>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="OverlayShown" type="b" access="read"/>
    <signal name="ScreenOffChanged">
      <arg name="screenOff" type="b"/>
    </signal>
  </interface>
</node>
