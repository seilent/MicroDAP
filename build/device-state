#!/usr/bin/bash
set -eu

device="${1:?usage: device-state user@host}"

os_release=$(ssh "${device}" cat /usr/lib/os-release)
status=$(ssh "${device}" rpm-ostree status --booted --json)

value() { sed -n "s/^$1=//p" <<<"${os_release}" | tr -d '"'; }

image_version=$(value IMAGE_VERSION)
version_id=$(value VERSION_ID)
ref=$(jq -r '.deployments[0]["container-image-reference"] // empty' <<<"${status}")
digest=$(jq -r '.deployments[0]["container-image-reference-digest"] // empty' <<<"${status}")

if [[ -z "${digest}" ]]; then
    digest=$(ssh -t "${device}" sudo bootc status --json | jq -r '.status.booted.image.imageDigest // empty')
fi

[[ -n "${image_version}" && -n "${version_id}" && -n "${ref}" && -n "${digest}" ]] \
    || { echo "device-state: incomplete state from ${device}" >&2; exit 1; }

repo=${ref##*registry:}
repo=${repo##*docker://}
repo=${repo%@*}
repo=${repo%:*}

echo "BASE_IMAGE=${repo}@${digest}"
echo "IMAGE_VERSION=${image_version}"
echo "VERSION_ID=${version_id}"
