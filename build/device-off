#!/usr/bin/bash
set -eu

user="${SUDO_USER:-armada}"
uid=$(id -u "${user}")
extensions="${MICRODAP_EXTENSIONS_DIR:-/var/lib/extensions}"
run_dir="${MICRODAP_RUN:-/run/microdap}"
autologin="${MICRODAP_SDDM_CONF_DIR:-/etc/sddm.conf.d}/zz-holo-autologin.conf"
controller_type="${MICRODAP_CONTROLLER_TYPE:-/usr/libexec/armada/controller-type}"
session_control="${MICRODAP_SESSION_CONTROL:-/usr/libexec/armada/session-control}"
wait_limit="${MICRODAP_OFF_WAIT:-60}"

as_user() {
    runuser -u "${user}" -- env XDG_RUNTIME_DIR="/run/user/${uid}" "$@"
}

session_busy() {
    case "$(as_user systemctl --user show -p ActiveState --value gamescope-session-plus@microdap.service)" in
        active|activating|deactivating|reloading|refreshing) return 0 ;;
    esac
    return 1
}

autologin_microdap() {
    grep -qsx 'Session=microdap.desktop' "${autologin}"
}

if session_busy; then
    systemctl --no-block start microdap-switch-back.service
elif autologin_microdap; then
    "${session_control}" default-gamemode || { echo "device-off: default-gamemode failed, refusing" >&2; exit 1; }
fi
waited=0
while session_busy || autologin_microdap; do
    if (( waited >= wait_limit )); then
        echo "device-off: microdap still active or in the autologin after ${wait_limit} s, refusing" >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

as_user systemctl --user stop microdap-overlay.service microdap-bt.service microdap-pad.service microdap-powerd.service || true
rm -rf "${extensions}/microdap" "${run_dir}"
systemd-sysext refresh
systemctl daemon-reload
systemctl stop microdap-guard.service microdap-usb-audio.service 2>/dev/null || true
as_user systemctl --user daemon-reload
as_user systemctl --user stop microdap-hotkeyd.service || true
systemctl restart polkit inputplumber.service
"${controller_type}" apply || echo "device-off: controller-type apply failed" >&2
systemd-sysext status
