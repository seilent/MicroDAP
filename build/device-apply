#!/usr/bin/bash
set -eu

input="${1:-}"

mkdir -p /var/lib/extensions/casdap
changed=$(rsync -ai --delete /tmp/casdap/ /var/lib/extensions/casdap/)
systemd-sysext refresh
systemctl restart polkit
systemctl restart casdap-guard.service
if [[ -n "${input}" ]] || grep -q 'usr/share/inputplumber/' <<<"${changed}"; then
    systemctl restart inputplumber.service
    systemctl start armada-controller-type.service
fi
if grep -q 'usr/share/pipewire/' <<<"${changed}"; then
    : > /tmp/casdap-restart-audio
    chown "${SUDO_USER:-root}" /tmp/casdap-restart-audio
fi
systemctl show -p NeedDaemonReload casdap-switch.service
systemd-sysext status
