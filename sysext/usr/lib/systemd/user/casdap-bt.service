[Unit]
Description=CASDAP Bluetooth receiver agent
BindsTo=gamescope-session-plus@casdap.service
After=gamescope-session-plus@casdap.service

[Service]
ExecStartPre=/usr/bin/systemctl start casdap-priv@bt-class-headphones.service
ExecStart=/usr/libexec/casdap/casdap-bt
ExecStopPost=/usr/bin/systemctl start casdap-priv@bt-class-default.service
Restart=on-failure
RestartSec=5
