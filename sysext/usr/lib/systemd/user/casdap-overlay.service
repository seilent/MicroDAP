[Unit]
Description=CASDAP overlay player
BindsTo=gamescope-session-plus@steam.service
After=gamescope-session-plus@steam.service
Conflicts=gamescope-session-plus@casdap.service
After=gamescope-session-plus@casdap.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=15
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
ExecCondition=/usr/libexec/casdap/casdap-keep check
ExecStart=/usr/bin/casdap-player --overlay
ExecStopPost=/usr/libexec/casdap/casdap-intercept 0
Restart=on-failure
RestartSec=2
