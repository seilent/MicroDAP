#!/usr/bin/bash
set -uo pipefail

LONG_MS="${MICRODAP_POWERD_LONG_MS:-1000}"
DEVICE_WAIT_SEC="${MICRODAP_POWERD_DEVICE_WAIT_SEC:-15}"
DEVICE_NAME="${MICRODAP_POWERD_DEVICE_NAME:-pm8941_pwrkey}"
POLL_SEC="${MICRODAP_POWERD_POLL_SEC:-5}"
BUZZ_LEVEL="${MICRODAP_POWERD_BUZZ_LEVEL:-1.0}"
BUZZ_MS="${MICRODAP_POWERD_BUZZ_MS:-15}"
DEBOUNCE_MS="${MICRODAP_POWER_DEBOUNCE_MS:-2000}"
DRY_RUN="${MICRODAP_POWERD_DRY_RUN:-0}"
KEY="${MICRODAP_POWERD_KEY:-KEY_POWER}"
DEV_INPUT="${MICRODAP_DEV_INPUT:-/dev/input}"
SYS_INPUT="${MICRODAP_SYS_INPUT:-/sys/class/input}"
RUNTIME="${MICRODAP_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/microdap-power}"
PATH="${PATH}:/usr/libexec/microdap"

log() { logger -t microdap-powerd -- "$*"; }

now_ms() { date +%s%3N; }

event_ms() {
    local re='time ([0-9]+)\.([0-9]+),' usec
    [[ "$1" =~ ${re} ]] || return 0
    usec="${BASH_REMATCH[2]}000000"
    printf '%d\n' $(( BASH_REMATCH[1] * 1000 + 10#${usec:0:3} ))
}

anchor_ms() {
    if [[ -n "$1" ]] && (( $2 - $1 >= 0 && $2 - $1 <= 60000 )); then
        printf '%d\n' "$1"
    else
        printf '%d\n' "$2"
    fi
}

gap_ms() {
    if [[ -n "$1" && -n "$3" ]] && (( $3 - $1 >= 0 && $3 - $1 <= 60000 )); then
        printf '%d\n' $(( $3 - $1 ))
    else
        printf '%d\n' $(( $4 - $2 ))
    fi
}

run() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: $*"
        return 0
    fi
    "$@" || log "failed: $* (rc=$?)"
}

ms_sec() { printf '%d.%03d' $((10#$1 / 1000)) $((10#$1 % 1000)); }

rumble() {
    local level=$1 path
    shift
    for path in "$@"; do
        busctl --system call org.shadowblip.InputPlumber "${path}" org.shadowblip.Output.ForceFeedback Rumble d "${level}" \
            >/dev/null 2>&1 || true
    done
}

buzz() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: buzz $*"
        return 0
    fi
    (
        local devs ms
        [[ "$1" =~ ^[0-9]+$ ]] || exit 0
        ms=$1
        mapfile -t devs < <(busctl --system tree --list org.shadowblip.InputPlumber 2>/dev/null \
            | grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$')
        (( ${#devs[@]} )) || exit 0
        trap 'rumble 0 "${devs[@]}"; exit 0' INT TERM
        rumble "${BUZZ_LEVEL}" "${devs[@]}"
        sleep "$(ms_sec "${ms}")"
        rumble 0 "${devs[@]}"
    ) 3<&- </dev/null >/dev/null 2>&1 &
}

toggle_will_act() {
    local last
    last=$(cat "${RUNTIME}/last-ms" 2>/dev/null) || last=0
    [[ "${last}" =~ ^[0-9]+$ ]] || last=0
    (( $(now_ms) - last >= DEBOUNCE_MS )) || return 1
    [[ -d "${RUNTIME}" ]] || return 0
    flock -n "${RUNTIME}/lock" true 2>/dev/null
}

key_device() {
    local dev name
    for dev in "${DEV_INPUT}"/event*; do
        [[ -e "${dev}" ]] || continue
        name=$(cat "${SYS_INPUT}/$(basename "${dev}")/device/name" 2>/dev/null) || continue
        [[ "${name}" == "$1" ]] || continue
        printf '%s\n' "${dev}"
        return 0
    done
    return 1
}

wait_for_key_device() {
    local waited=0
    while :; do
        key_device "${DEVICE_NAME}" && return 0
        (( waited >= DEVICE_WAIT_SEC )) && return 1
        sleep 1
        waited=$((waited + 1))
    done
}

profile_stream() {
    local value
    while :; do
        value=$(busctl --system get-property org.armada.Power /org/armada/Power org.armada.Power Profile 2>/dev/null) \
            && printf 'profile %s\n' "${value}"
        sleep "${POLL_SEC}" >/dev/null 2>&1
    done
}

event_stream() {
    local pids=()
    evtest "$1" 2>/dev/null &
    pids+=($!)
    profile_stream &
    pids+=($!)
    wait -n
    kill "${pids[@]}" 2>/dev/null
}

on_tap() {
    if toggle_will_act; then
        buzz "${BUZZ_MS}"
    else
        log "tap during a transition or the debounce, no buzz"
    fi
    run microdap-power toggle
}

on_hold() {
    buzz "${BUZZ_MS}"
    if [[ -e "${RUNTIME}/off" ]]; then
        log "hold while off, screen on first"
        run microdap-power screen-on
    fi
    run busctl --user call net.seilent.MicroDap.Player /net/seilent/MicroDap/Player net.seilent.MicroDap.Player ShowPowerMenu
}

on_profile() {
    if [[ -n "${profile}" && "$1" != "${profile}" ]]; then
        log "profile ${profile} to $1, applying the cpu floor"
        run microdap-power cpu-apply
    fi
    profile=$1
}

profile=

main() {
    local dev line partial read_result state press_ms press_raw press_at release_ms rem

    trap 'exit 0' INT TERM

    dev=$(wait_for_key_device) || {
        log "${DEVICE_NAME} not found after ${DEVICE_WAIT_SEC} s"
        return 0
    }

    log "watching ${dev} for ${KEY}, hold ${LONG_MS} ms, profile poll ${POLL_SEC} s, dry run ${DRY_RUN}"
    exec 3< <(event_stream "${dev}")
    state=idle
    press_ms=0
    partial=
    press_raw=
    press_at=0

    while :; do
        read_result=0
        case "${state}" in
            held)
                rem=$((press_at + LONG_MS - $(now_ms)))
                if (( rem > 0 )); then
                    IFS= read -r -u 3 -t "$(ms_sec "${rem}")" line 2>/dev/null || read_result=$?
                elif read -t 0 -u 3 2>/dev/null; then
                    IFS= read -r -u 3 line 2>/dev/null || read_result=$?
                else
                    log "hold"
                    on_hold
                    state=draining
                    continue
                fi
                ;;
            *)
                IFS= read -r -u 3 line 2>/dev/null || read_result=$?
                ;;
        esac

        if (( read_result > 128 )) && [[ "${state}" == held ]]; then
            partial+=${line}
            continue
        elif (( read_result != 0 )); then
            log "event stream ended"
            return 1
        fi
        line=${partial}${line}
        partial=

        case "${line}" in
            *"(${KEY}), value 1"*)
                [[ "${state}" == idle ]] || continue
                press_ms=$(now_ms)
                press_raw=$(event_ms "${line}")
                press_at=$(anchor_ms "${press_raw}" "${press_ms}")
                state=held
                ;;
            *"(${KEY}), value 0"*)
                if [[ "${state}" == held ]]; then
                    release_ms=$(now_ms)
                    if (( $(gap_ms "${press_raw}" "${press_ms}" "$(event_ms "${line}")" "${release_ms}") >= LONG_MS )); then
                        log "hold"
                        on_hold
                    else
                        on_tap
                    fi
                fi
                state=idle
                ;;
            "profile "*)
                on_profile "${line#profile }"
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
