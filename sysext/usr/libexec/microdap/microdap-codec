#!/usr/bin/bash
set -eu

config="${XDG_CONFIG_HOME:-${HOME}/.config}"
conf_dir="${MICRODAP_WP_CONF_DIR:-${config}/wireplumber/wireplumber.conf.d}"
keep_bin="${MICRODAP_KEEP_BIN:-/usr/libexec/microdap/microdap-keep}"
systemctl_bin="${MICRODAP_SYSTEMCTL_BIN:-systemctl}"
fragment="${conf_dir}/50-microdap-codec.conf"

log() { logger -t microdap-codec -- "$*" 2>/dev/null || true; }

clear_fragment() {
    [[ -e "${fragment}" ]] || return 0
    if "${keep_bin}" check >/dev/null 2>&1; then
        log "phone kept, fragment kept"
        return 0
    fi
    rm -f -- "${fragment}"
    log "fragment removed ${fragment}"
    if ! "${systemctl_bin}" --user restart wireplumber; then
        log "wireplumber restart failed"
        return 1
    fi
}

[[ $# -eq 1 ]] || exit 1

case "$1" in
    clear) clear_fragment ;;
    *) exit 1 ;;
esac
