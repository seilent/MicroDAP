#!/usr/bin/bash
set -eu

runtime="${MICRODAP_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/microdap-power}"
settings="${MICRODAP_SETTINGS_FILE:-${HOME}/.config/microdap/settings.ini}"
before="${MICRODAP_CPU_BEFORE_FILE:-/run/microdap/cpu-before}"
debounce_ms="${MICRODAP_POWER_DEBOUNCE_MS:-2000}"
idle_period="${MICRODAP_POWER_IDLE_PERIOD:-60}"
self=/usr/libexec/microdap/microdap-power
session=gamescope-session-plus@microdap.service
player=(net.seilent.MicroDap.Player /net/seilent/MicroDap/Player net.seilent.MicroDap.Player)
lock_held=

log() { logger -t microdap-power -- "$*"; }

now_ms() { date +%s%3N; }

take_lock() {
    mkdir -p "${runtime}"
    if [[ -z "${lock_held}" ]]; then
        exec 9>"${runtime}/lock"
    fi
    if [[ "$1" == try ]]; then
        flock -n 9 || return 1
    elif ! flock -w 10 9; then
        log "lock timeout"
        exit 1
    fi
    lock_held=1
}

run() {
    "$@" || log "failed: $* (rc=$?)"
}

session_state() {
    systemctl --user is-active "${session}" 2>/dev/null || true
}

require_session() {
    local state
    state=$(session_state)
    if [[ "${state}" != active ]]; then
        log "$1 outside the microdap session (${state:-unknown}), ignored"
        exit 1
    fi
}

setting() {
    local line value=
    if [[ -r "${settings}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line%$'\r'}"
            [[ "${line}" == "$1="* ]] || continue
            value="${line#*=}"
        done < "${settings}"
    fi
    printf '%s\n' "${value:-$2}"
}

lights_on() {
    case "$(setting rgb armada)" in
        accent|armada) return 0 ;;
        *) return 1 ;;
    esac
}

set_screen_off() {
    run busctl --user --timeout=2 call "${player[@]}" SetScreenOff b "$1"
}

stop_idle() {
    systemctl --user stop microdap-idle.timer 2>/dev/null || true
}

arm_idle() {
    stop_idle
    run systemd-run --user --unit=microdap-idle --on-active="${idle_period}" --on-unit-inactive="${idle_period}" \
        --timer-property=AccuracySec=1min "${self}" idle-check
}

screen_off() {
    require_session screen-off
    take_lock blocking
    log "screen off"
    : > "${runtime}/off"
    set_screen_off true
    run systemctl start microdap-priv@backlight-off.service
    if lights_on; then
        run systemctl start microdap-priv@rgb-sleep.service
    fi
    now_ms > "${runtime}/last-ms"
    run systemctl start microdap-priv@cpu-off.service
    if [[ "$(setting wifiOffScreenOff false)" == true && ! -e "${runtime}/wifi" ]]; then
        if nmcli radio wifi off; then
            : > "${runtime}/wifi"
        else
            log "failed: nmcli radio wifi off (rc=$?)"
        fi
    fi
    arm_idle
}

screen_on() {
    local state was_off=
    state=$(session_state)
    take_lock blocking
    log "screen on (session ${state:-unknown})"
    [[ -e "${runtime}/off" ]] && was_off=1
    run systemctl start microdap-priv@backlight-on.service
    rm -f -- "${runtime}/off"
    if [[ "${state}" == active ]]; then
        set_screen_off false
    fi
    if lights_on; then
        run systemctl start microdap-priv@rgb-wake.service
    fi
    now_ms > "${runtime}/last-ms"
    stop_idle
    if [[ -e "${runtime}/wifi" ]]; then
        run nmcli radio wifi on
        rm -f -- "${runtime}/wifi"
    fi
    if [[ "${state}" == active ]]; then
        if [[ -z "${was_off}" && -e "${before}" ]]; then
            run systemctl start microdap-priv@cpu-restore.service
        fi
        run systemctl start microdap-priv@cpu-dap.service
    else
        run systemctl start microdap-priv@cpu-restore.service
    fi
}

toggle() {
    local now last
    require_session toggle
    if ! take_lock try; then
        log "toggle during a transition, ignored"
        return 0
    fi
    now=$(now_ms)
    last=$(cat "${runtime}/last-ms" 2>/dev/null || echo 0)
    [[ "${last}" =~ ^[0-9]+$ ]] || last=0
    if (( now - last < debounce_ms )); then
        log "toggle within ${debounce_ms} ms of the last transition, ignored"
        return 0
    fi
    if [[ -e "${runtime}/off" ]]; then
        screen_on
    else
        screen_off
    fi
}

cpu_apply() {
    require_session cpu-apply
    run systemctl start microdap-priv@cpu-resave.service
    if [[ -e "${runtime}/off" ]]; then
        run systemctl start microdap-priv@cpu-off.service
    else
        run systemctl start microdap-priv@cpu-dap.service
    fi
}

playing() {
    local status
    status=$(busctl --user get-property "${player[@]}" PlaybackStatus 2>/dev/null) || return 1
    [[ "${status}" == *Playing* ]]
}

transport_active() {
    local path value
    while read -r path; do
        [[ -n "${path}" ]] || continue
        value=$(busctl --system get-property org.bluez "${path}" org.bluez.MediaTransport1 State 2>/dev/null) || continue
        if [[ "${value}" == 's "active"' ]]; then
            return 0
        fi
    done < <(busctl --system tree --list org.bluez 2>/dev/null | grep -E '/fd[0-9]+$' || true)
    return 1
}

idle_check() {
    local minutes since now
    [[ "$(session_state)" == active ]] || return 0
    if playing || transport_active; then
        rm -f -- "${runtime}/idle-since"
        return 0
    fi
    minutes=$(setting suspendMinutes 10)
    [[ "${minutes}" =~ ^[0-9]+$ ]] || minutes=0
    if (( minutes == 0 )); then
        rm -f -- "${runtime}/idle-since"
        return 0
    fi
    now=$(date +%s)
    if [[ ! -e "${runtime}/idle-since" ]]; then
        mkdir -p "${runtime}"
        echo "${now}" > "${runtime}/idle-since"
        return 0
    fi
    since=$(cat "${runtime}/idle-since")
    [[ "${since}" =~ ^[0-9]+$ ]] || since=${now}
    if (( now - since >= minutes * 60 )); then
        log "idle for ${minutes} min, suspending"
        rm -f -- "${runtime}/idle-since"
        systemctl suspend
    fi
}

[[ $# -eq 1 ]] || exit 1

case "$1" in
    screen-off) screen_off ;;
    screen-on)  screen_on ;;
    toggle)     toggle ;;
    cpu-apply)  cpu_apply ;;
    idle-check) idle_check ;;
    suspend)    systemctl suspend ;;
    poweroff)   systemctl poweroff ;;
    *) exit 1 ;;
esac
