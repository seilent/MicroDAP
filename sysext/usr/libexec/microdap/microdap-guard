#!/usr/bin/bash
set -eu

share="${MICRODAP_SHARE:-/usr/share/microdap}"
run="${MICRODAP_RUN:-/run/microdap}"
sysroot="${MICRODAP_SYSROOT:-/sysroot}"
cmdline="${MICRODAP_CMDLINE:-/proc/cmdline}"
os_release="${MICRODAP_OS_RELEASE:-/usr/lib/os-release}"
session_control="${MICRODAP_SESSION_CONTROL:-/usr/libexec/armada/session-control}"
hashes="${share}/shadow-base.sha256"
manifest="${share}/build-manifest"

log() { logger -t microdap-guard -- "$*"; }

deployment() {
    local arg
    for arg in $(<"${cmdline}"); do
        [[ "${arg}" == ostree=* ]] || continue
        realpath -e "${sysroot}/${arg#ostree=}"
        return
    done
    return 1
}

drift() {
    logger -t microdap-guard -p user.warning -- "$1 differs from the image this microdap was built against"
    echo "$1" >> "${run}/drift"
}

mkdir -p "${run}"
rm -f "${run}/drift"

if ! "${session_control}" list-sessions 2>/dev/null | grep -qx microdap; then
    logger -t microdap-guard -p user.warning -- "session-control does not list the microdap session"
    echo "${session_control}" >> "${run}/drift"
fi

[[ -r "${hashes}" ]] || exit 0

if deploy=$(deployment); then
    log "booted deployment ${deploy}"
    while read -r sum path; do
        [[ -n "${path}" ]] || continue
        actual=$(sha256sum "${deploy}${path}" 2>/dev/null) || actual=missing
        [[ "${actual%% *}" == "${sum}" ]] || drift "${path}"
    done < "${hashes}"
    exit 0
fi

built=$(sed -n 's/^IMAGE_VERSION=//p' "${manifest}")
running=$(sed -n 's/^IMAGE_VERSION=//p' "${os_release}" | tr -d '"')
if [[ "${running}" != "${built}" ]]; then
    logger -t microdap-guard -p user.warning -- "cannot resolve the booted deployment and image ${running} differs from build ${built}"
    while read -r sum path; do
        [[ -n "${path}" ]] || continue
        drift "${path}"
    done < "${hashes}"
fi
exit 0
