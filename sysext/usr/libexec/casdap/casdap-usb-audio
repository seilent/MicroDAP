#!/usr/bin/bash
set -eu

sys="${CASDAP_SYS_ROOT:-/sys}"
unbind="${sys}/bus/usb/drivers/usbhid/unbind"

log() { logger -t casdap-usb-audio -- "$*"; }

generic_desktop() {
    local file bytes=() n i b size v k
    for file in "$1"/*/report_descriptor; do
        break
    done
    [[ -r "${file}" ]] || return 0
    read -r -d '' -a bytes < <(od -An -v -tu1 "${file}" 2>/dev/null) || true
    n=${#bytes[@]}
    (( n > 0 )) || return 0
    i=0
    while (( i < n )); do
        b=${bytes[i]}
        if (( b == 0xfe )); then
            (( i + 2 < n )) || return 0
            i=$(( i + 3 + bytes[i + 1] ))
            (( i <= n )) || return 0
            continue
        fi
        size=$(( b & 3 ))
        (( size == 3 )) && size=4
        (( i + size < n )) || return 0
        v=0
        for (( k = size; k >= 1; k-- )); do
            v=$(( (v << 8) | bytes[i + k] ))
        done
        (( (b & 0xfc) == 0x04 && v == 1 )) && return 0
        (( (b & 0xfc) == 0x08 && size == 4 && (v >> 16) == 1 )) && return 0
        i=$(( i + 1 + size ))
    done
    return 1
}

handle() {
    local dev name intf class audio=0 hid=() id ok
    dev=$(realpath -e "$1" 2>/dev/null) || return 0
    [[ -r "${dev}/idVendor" ]] || return 0
    name=${dev##*/}
    for intf in "${dev}/${name}":*; do
        [[ -r "${intf}/bInterfaceClass" ]] || continue
        class=$(<"${intf}/bInterfaceClass")
        case "${class}" in
            01) audio=1 ;;
            03)
                [[ "$(realpath -e "${intf}/driver" 2>/dev/null)" == */usbhid ]] && hid+=("${intf}")
                ;;
        esac
    done
    (( audio && ${#hid[@]} )) || return 0
    for intf in "${hid[@]}"; do
        if generic_desktop "${intf}"; then
            log "${name} skipped, generic desktop hid"
            return 0
        fi
    done
    id="$(<"${dev}/idVendor"):$(<"${dev}/idProduct")"
    for intf in "${hid[@]}"; do
        if printf '%s' "${intf##*/}" 2>/dev/null > "${unbind}"; then
            log "${name} ${id} hid ${intf##*/} unbound"
        else
            log "${name} ${id} hid ${intf##*/} unbind failed"
        fi
    done
    ok=1
    if ! printf auto 2>/dev/null > "${dev}/power/control"; then
        log "${name} power/control write failed"
        ok=0
    fi
    if ! printf 2000 2>/dev/null > "${dev}/power/autosuspend_delay_ms"; then
        log "${name} power/autosuspend_delay_ms write failed"
        ok=0
    fi
    (( ok )) && log "${name} autosuspend on"
    return 0
}

if [[ "${1:-}" == --scan ]]; then
    for dev in "${sys}"/bus/usb/devices/*; do
        handle "${dev}"
    done
    exit 0
fi

[[ -n "${1:-}" ]] || { echo "usage: casdap-usb-audio <usb device path>|--scan" >&2; exit 2; }
handle "$1"
