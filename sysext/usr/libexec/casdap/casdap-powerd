#!/usr/bin/bash
set -uo pipefail

LONG_MS="${CASDAP_POWERD_LONG_MS:-1000}"
DEVICE_WAIT_SEC="${CASDAP_POWERD_DEVICE_WAIT_SEC:-15}"
DEVICE_NAME="${CASDAP_POWERD_DEVICE_NAME:-pm8941_pwrkey}"
POLL_SEC="${CASDAP_POWERD_POLL_SEC:-5}"
BUZZ_LEVEL="${CASDAP_POWERD_BUZZ_LEVEL:-0.6}"
BUZZ_MS="${CASDAP_POWERD_BUZZ_MS:-60}"
DEBOUNCE_MS="${CASDAP_POWER_DEBOUNCE_MS:-2000}"
DRY_RUN="${CASDAP_POWERD_DRY_RUN:-0}"
KEY="${CASDAP_POWERD_KEY:-KEY_POWER}"
DEV_INPUT="${CASDAP_DEV_INPUT:-/dev/input}"
SYS_INPUT="${CASDAP_SYS_INPUT:-/sys/class/input}"
RUNTIME="${CASDAP_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casdap-power}"
PATH="${PATH}:/usr/libexec/casdap"

log() { logger -t casdap-powerd -- "$*"; }

now_ms() { date +%s%3N; }

run() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: $*"
        return 0
    fi
    "$@" || log "failed: $* (rc=$?)"
}

ms_sec() { printf '%d.%03d' $((10#$1 / 1000)) $((10#$1 % 1000)); }

rumble() {
    local level=$1 path
    shift
    for path in "$@"; do
        busctl --system call org.shadowblip.InputPlumber "${path}" org.shadowblip.Output.ForceFeedback Rumble d "${level}" \
            >/dev/null 2>&1 || true
    done
}

buzz() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: buzz $*"
        return 0
    fi
    (
        local devs ms
        [[ "$1" =~ ^[0-9]+$ ]] || exit 0
        ms=$1
        mapfile -t devs < <(busctl --system tree --list org.shadowblip.InputPlumber 2>/dev/null \
            | grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$')
        (( ${#devs[@]} )) || exit 0
        trap 'rumble 0 "${devs[@]}"; exit 0' INT TERM
        rumble "${BUZZ_LEVEL}" "${devs[@]}"
        sleep "$(ms_sec "${ms}")"
        rumble 0 "${devs[@]}"
    ) 3<&- </dev/null >/dev/null 2>&1 &
}

toggle_will_act() {
    local last
    last=$(cat "${RUNTIME}/last-ms" 2>/dev/null) || last=0
    [[ "${last}" =~ ^[0-9]+$ ]] || last=0
    (( $(now_ms) - last >= DEBOUNCE_MS )) || return 1
    [[ -d "${RUNTIME}" ]] || return 0
    flock -n "${RUNTIME}/lock" true 2>/dev/null
}

key_device() {
    local dev name
    for dev in "${DEV_INPUT}"/event*; do
        [[ -e "${dev}" ]] || continue
        name=$(cat "${SYS_INPUT}/$(basename "${dev}")/device/name" 2>/dev/null) || continue
        [[ "${name}" == "$1" ]] || continue
        printf '%s\n' "${dev}"
        return 0
    done
    return 1
}

wait_for_key_device() {
    local waited=0
    while :; do
        key_device "${DEVICE_NAME}" && return 0
        (( waited >= DEVICE_WAIT_SEC )) && return 1
        sleep 1
        waited=$((waited + 1))
    done
}

profile_stream() {
    local value
    while :; do
        value=$(busctl --system get-property org.armada.Power /org/armada/Power org.armada.Power Profile 2>/dev/null) \
            && printf 'profile %s\n' "${value}"
        sleep "${POLL_SEC}" >/dev/null 2>&1
    done
}

event_stream() {
    local pids=()
    evtest "$1" 2>/dev/null &
    pids+=($!)
    profile_stream &
    pids+=($!)
    wait -n
    kill "${pids[@]}" 2>/dev/null
}

on_tap() {
    if toggle_will_act; then
        buzz "${BUZZ_MS}"
    else
        log "tap during a transition or the debounce, no buzz"
    fi
    run casdap-power toggle
}

on_hold() {
    buzz "${BUZZ_MS}"
    if [[ -e "${RUNTIME}/off" ]]; then
        log "hold while off, screen on first"
        run casdap-power screen-on
    fi
    run busctl --user call org.casdap.Player /org/casdap/Player org.casdap.Player ShowPowerMenu
}

on_profile() {
    if [[ -n "${profile}" && "$1" != "${profile}" ]]; then
        log "profile ${profile} to $1, applying the cpu floor"
        run casdap-power cpu-apply
    fi
    profile=$1
}

profile=

main() {
    local dev line read_result state press_ms rem

    trap 'exit 0' INT TERM

    dev=$(wait_for_key_device) || {
        log "${DEVICE_NAME} not found after ${DEVICE_WAIT_SEC} s"
        return 0
    }

    log "watching ${dev} for ${KEY}, hold ${LONG_MS} ms, profile poll ${POLL_SEC} s, dry run ${DRY_RUN}"
    exec 3< <(event_stream "${dev}")
    state=idle
    press_ms=0

    while :; do
        read_result=0
        case "${state}" in
            held)
                rem=$((LONG_MS - ($(now_ms) - press_ms)))
                if (( rem <= 0 )); then
                    log "hold"
                    on_hold
                    state=draining
                    continue
                fi
                IFS= read -r -u 3 -t "$(printf '%d.%03d' $((rem / 1000)) $((rem % 1000)))" line 2>/dev/null \
                    || read_result=$?
                ;;
            *)
                IFS= read -r -u 3 line 2>/dev/null || read_result=$?
                ;;
        esac

        if (( read_result > 128 )) && [[ "${state}" == held ]]; then
            continue
        elif (( read_result != 0 )); then
            log "event stream ended"
            return 1
        fi

        case "${line}" in
            *"(${KEY}), value 1"*)
                [[ "${state}" == idle ]] || continue
                press_ms=$(now_ms)
                state=held
                ;;
            *"(${KEY}), value 0"*)
                case "${state}" in
                    held) on_tap ;;
                esac
                state=idle
                ;;
            "profile "*)
                on_profile "${line#profile }"
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
