#!/usr/bin/bash
set -eu

sysfs="${CASDAP_SYSFS_ROOT:-/sys}"
before="${CASDAP_CPU_BEFORE_FILE:-/run/casdap/cpu-before}"
cpu="${sysfs}/devices/system/cpu"
gpu="${sysfs}/class/devfreq/3d00000.gpu"
amixer="${CASDAP_AMIXER_BIN:-amixer}"
rgb="${CASDAP_RGB_BIN:-/usr/libexec/armada/armada-rgb-env}"
rgb_config="${CASDAP_RGB_CONFIG:-/etc/armada/rgb.json}"
rgb_before="${CASDAP_RGB_BEFORE_FILE:-/run/casdap/rgb-before.json}"
levels=(0 40 60 80 100)
failed=0

backlight() {
    local bl
    for bl in "${sysfs}"/class/backlight/*/bl_power; do
        [[ -w "${bl}" ]] || continue
        echo "$1" > "${bl}"
    done
    return 0
}

put() {
    if [[ ! -e "$1" ]]; then
        echo "casdap-priv: $1 missing" >&2
        failed=1
        return 0
    fi
    if ! echo "$2" > "$1" 2>/dev/null; then
        echo "casdap-priv: write $2 to $1 failed" >&2
        failed=1
    fi
    return 0
}

save() {
    local tmp p
    if [[ -e "${before}" ]]; then
        return 0
    fi
    mkdir -p "$(dirname "${before}")"
    tmp="${before}.tmp"
    : > "${tmp}"
    for p in "${cpu}"/cpufreq/policy*/scaling_max_freq "${cpu}"/cpu[0-9]*/online "${gpu}/governor" "${gpu}/max_freq"; do
        [[ -r "${p}" ]] || continue
        printf '%s %s\n' "${p}" "$(< "${p}")" >> "${tmp}"
    done
    mv "${tmp}" "${before}"
}

cpu_dap() {
    local n
    save
    for n in 1 2 3; do
        put "${cpu}/cpu${n}/online" 1
    done
    put "${cpu}/cpufreq/policy0/scaling_max_freq" 787200
    for n in 4 5 6 7; do
        put "${cpu}/cpu${n}/online" 0
    done
    put "${gpu}/governor" simple_ondemand
    put "${gpu}/max_freq" 305000000
}

cpu_off() {
    local n
    save
    for n in 1 2 3 4 5 6 7; do
        put "${cpu}/cpu${n}/online" 0
    done
    put "${cpu}/cpufreq/policy0/scaling_max_freq" 518400
}

cpu_restore() {
    local n path value
    for n in 1 2 3 4 5 6 7; do
        put "${cpu}/cpu${n}/online" 1
    done
    if [[ ! -e "${before}" ]]; then
        echo "casdap-priv: ${before} missing, cores online only" >&2
        return 0
    fi
    while read -r path value; do
        [[ -n "${path}" && "${path}" != */online ]] || continue
        put "${path}" "${value}"
    done < "${before}"
    if (( failed == 0 )); then
        rm -f -- "${before}"
    fi
}

cset() {
    if ! "${amixer}" -D hw:0 cset name="$1" "$2" > /dev/null; then
        echo "casdap-priv: cset $1 $2 failed" >&2
        failed=1
    fi
    return 0
}

hp_gain() {
    cset 'HPHL Volume' "$1"
    cset 'HPHR Volume' "$1"
}

hp_amp() {
    cset 'RX HPH Mode' "$1"
    cset 'RX_HPH PWR Mode' "$2"
}

spk_gain() {
    cset 'WSA_RX0 Digital Volume' "$1"
    cset 'WSA_RX1 Digital Volume' "$1"
}

rgb_run() {
    if ! "${rgb}" "$@" > /dev/null; then
        echo "casdap-priv: armada-rgb $* failed" >&2
        failed=1
    fi
    return 0
}

rgb_save() {
    local tmp
    if [[ -e "${rgb_before}" ]]; then
        return 0
    fi
    mkdir -p "$(dirname "${rgb_before}")"
    tmp="${rgb_before}.tmp"
    if [[ -e "${rgb_config}" ]]; then
        cp -- "${rgb_config}" "${tmp}"
    else
        : > "${tmp}"
    fi
    mv "${tmp}" "${rgb_before}"
}

color_hex() {
    local h=$1 l=$2 k f lo span up down
    k=$(( h / 60 ))
    f=$(( h % 60 ))
    lo=$(( (255 * (100 - l) + 50) / 100 ))
    span=$(( 255 - lo ))
    up=$(( lo + (span * f + 30) / 60 ))
    down=$(( lo + (span * (60 - f) + 30) / 60 ))
    case "${k}" in
        0) printf '%02X%02X%02X' 255 "${up}" "${lo}" ;;
        1) printf '%02X%02X%02X' "${down}" 255 "${lo}" ;;
        2) printf '%02X%02X%02X' "${lo}" 255 "${up}" ;;
        3) printf '%02X%02X%02X' "${lo}" "${down}" 255 ;;
        4) printf '%02X%02X%02X' "${up}" "${lo}" 255 ;;
        5) printf '%02X%02X%02X' 255 "${lo}" "${down}" ;;
    esac
}

base_saturation() {
    local content base=100
    if [[ -s "${rgb_before}" ]]; then
        content=$(< "${rgb_before}")
        if [[ "${content}" =~ \"saturation\"[[:space:]]*:[[:space:]]*([0-9]{1,3}) ]]; then
            base=$(( 10#${BASH_REMATCH[1]} ))
        fi
    fi
    (( base <= 100 )) || base=100
    echo "${base}"
}

rgb_color() {
    local out line hex base enabled= link= brightness= max= saturation=
    hex=$(color_hex "$1" "$2")
    rgb_save
    base=$(base_saturation)
    if ! out=$("${rgb}" get); then
        echo "casdap-priv: armada-rgb get failed" >&2
        exit 1
    fi
    while IFS= read -r line; do
        [[ "${line}" =~ ^[[:space:]]*\"([A-Za-z]+)\":[[:space:]]*(true|false|[0-9]+) ]] || continue
        case "${BASH_REMATCH[1]}" in
            enabled)        enabled=${BASH_REMATCH[2]} ;;
            linkBrightness) link=${BASH_REMATCH[2]} ;;
            brightness)     brightness=${BASH_REMATCH[2]} ;;
            maxBrightness)  max=${BASH_REMATCH[2]} ;;
            saturation)     saturation=${BASH_REMATCH[2]} ;;
        esac
    done <<< "${out}"
    if [[ "${enabled}" != true && "${enabled}" != false ]] || [[ "${link}" != true && "${link}" != false ]] \
        || [[ ! "${brightness}" =~ ^[0-9]+$ || ! "${max}" =~ ^[0-9]+$ || ! "${saturation}" =~ ^[0-9]+$ ]]; then
        echo "casdap-priv: armada-rgb get lacks a key" >&2
        exit 1
    fi
    rgb_run set --enabled "${enabled}" --link-brightness "${link}" --max-brightness "${max}" --color "${hex}" \
        --saturation "$(( (base * $2 + 50) / 100 ))" --brightness "${brightness}"
}

hue_word() {
    local n=${1#rgb-hue-}
    [[ "${n}" =~ ^(0|[1-9][0-9]{1,2})$ ]] || exit 1
    (( n % 10 == 0 && n <= 350 )) || exit 1
    rgb_color "${n}" 100
}

color_word() {
    local rest=${1#rgb-color-} n s
    [[ "${rest}" =~ ^(0|[1-9][0-9]{1,2})-([1-4])$ ]] || exit 1
    n=${BASH_REMATCH[1]}
    s=${BASH_REMATCH[2]}
    (( n % 10 == 0 && n <= 350 )) || exit 1
    rgb_color "${n}" "${levels[s]}"
}

rgb_off() {
    rgb_save
    rgb_run off
}

rgb_restore() {
    local tmp
    [[ -e "${rgb_before}" ]] || return 0
    if [[ -s "${rgb_before}" ]]; then
        tmp="${rgb_config}.tmp"
        cp -- "${rgb_before}" "${tmp}"
        mv "${tmp}" "${rgb_config}"
    else
        rm -f -- "${rgb_config}"
    fi
    rgb_run apply
    if (( failed == 0 )); then
        rm -f -- "${rgb_before}"
    fi
}

[[ $# -eq 1 ]] || exit 1

case "$1" in
    bt-class-headphones) btmgmt class 4 24 ;;
    bt-class-default)    btmgmt class 0 0 ;;
    backlight-off)       backlight 4 ;;
    backlight-on)        backlight 0 ;;
    cpu-dap)             cpu_dap ;;
    cpu-off)             cpu_off ;;
    cpu-restore)         cpu_restore ;;
    hp-gain-low)         hp_gain 8 ;;
    hp-gain-normal)      hp_gain 20 ;;
    hp-gain-high)        hp_gain 24 ;;
    hp-amp-lohifi)       hp_amp CLS_H_LOHIFI LOHIFI ;;
    hp-amp-ulp)          hp_amp CLS_H_ULP ULP ;;
    hp-amp-hifi)         hp_amp CLS_H_HIFI LOHIFI ;;
    spk-gain-84)         spk_gain 84 ;;
    spk-gain-90)         spk_gain 90 ;;
    spk-gain-96)         spk_gain 96 ;;
    spk-gain-99)         spk_gain 99 ;;
    spk-gain-102)        spk_gain 102 ;;
    spk-gain-105)        spk_gain 105 ;;
    spk-gain-108)        spk_gain 108 ;;
    rgb-hue-*)           hue_word "$1" ;;
    rgb-color-*)         color_word "$1" ;;
    rgb-off)             rgb_off ;;
    rgb-sleep)           rgb_run sleep ;;
    rgb-wake)            rgb_run wake ;;
    rgb-restore)         rgb_restore ;;
    *) exit 1 ;;
esac

exit "${failed}"
