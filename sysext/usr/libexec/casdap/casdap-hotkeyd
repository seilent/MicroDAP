#!/usr/bin/bash
set -uo pipefail

LONG_MS="${CASDAP_HOTKEYD_LONG_MS:-1000}"
CONFIRM_MS="${CASDAP_HOTKEYD_CONFIRM_MS:-3000}"
TAP_MAX_AGE_MS="${CASDAP_HOTKEYD_TAP_MAX_AGE_MS:-300}"
DEVICE_WAIT_SEC="${CASDAP_HOTKEYD_DEVICE_WAIT_SEC:-15}"
DEVICE_NAME="${CASDAP_HOTKEYD_DEVICE_NAME:-InputPlumber Keyboard}"
VOLUME_NAMES="${CASDAP_HOTKEYD_VOLUME_NAMES-gpio-keys:pm8941_resin}"
DRY_RUN="${CASDAP_HOTKEYD_DRY_RUN:-0}"
KEY="${CASDAP_HOTKEYD_KEY:-KEY_F13}"
DEV_INPUT="${CASDAP_DEV_INPUT:-/dev/input}"
SYS_INPUT="${CASDAP_SYS_INPUT:-/sys/class/input}"
POWER_RUNTIME="${CASDAP_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casdap-power}"
SETTINGS="${CASDAP_SETTINGS_FILE:-${HOME}/.config/casdap/settings.ini}"
PATH="${PATH}:/usr/libexec/casdap"

log() { logger -t casdap-hotkeyd -- "$*"; }

now_ms() { date +%s%3N; }

event_ms() {
    local re='time ([0-9]+)\.([0-9]+),' usec
    [[ "$1" =~ ${re} ]] || return 0
    usec="${BASH_REMATCH[2]}000000"
    printf '%d\n' $(( BASH_REMATCH[1] * 1000 + 10#${usec:0:3} ))
}

run() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: $*"
        return 0
    fi
    "$@" || log "failed: $* (rc=$?)"
}

key_device() {
    local dev name
    for dev in "${DEV_INPUT}"/event*; do
        [[ -e "${dev}" ]] || continue
        name=$(cat "${SYS_INPUT}/$(basename "${dev}")/device/name" 2>/dev/null) || continue
        [[ "${name}" == "$1" ]] || continue
        printf '%s\n' "${dev}"
        return 0
    done
    return 1
}

wait_for_key_device() {
    local waited=0
    while :; do
        key_device "${DEVICE_NAME}" && return 0
        (( waited >= DEVICE_WAIT_SEC )) && return 1
        sleep 1
        waited=$((waited + 1))
    done
}

volume_devices() {
    local names name dev
    IFS=: read -r -a names <<< "${VOLUME_NAMES}"
    for name in "${names[@]}"; do
        [[ -n "${name}" ]] || continue
        if dev=$(key_device "${name}"); then
            printf '%s\n' "${dev}"
        else
            log "volume node ${name} not found"
        fi
    done
}

event_stream() {
    local dev pids=()
    for dev in "$@"; do
        evtest "${dev}" 2>/dev/null &
        pids+=($!)
    done
    wait -n
    kill "${pids[@]}" 2>/dev/null
}

session_state() {
    if systemctl --user is-active --quiet gamescope-session-plus@casdap.service; then
        echo casdap
    elif systemctl --user is-active --quiet gamescope-session-plus@steam.service; then
        echo game
    else
        echo other
    fi
}

title_running() { pgrep -f 'SteamLaunch AppId=' >/dev/null 2>&1; }

plasma_running() { pgrep -x plasmashell >/dev/null 2>&1; }

last_hold_ms=0
vol_key=
vol_session=
toggle_end_ms=0
toggle_timeouts=0

toggle_overlay() {
    local err rc=0 start
    start=$(now_ms)
    if [[ "${DRY_RUN}" == 1 ]]; then
        run busctl --user --timeout=2 call org.casdap.Player /org/casdap/Player org.casdap.Player ToggleOverlay
        toggle_end_ms=$(now_ms)
        return 0
    fi
    err=$(busctl --user --timeout=2 call org.casdap.Player /org/casdap/Player org.casdap.Player ToggleOverlay 2>&1 >/dev/null) || rc=$?
    toggle_end_ms=$(now_ms)
    log "ToggleOverlay rc=${rc} in $((toggle_end_ms - start)) ms"
    case "${err}" in
        *"Connection timed out"*) ;;
        *) toggle_timeouts=0 ;;
    esac
    (( rc == 0 )) && return 0
    case "${err}" in
        *"The name is not activatable"*)
            log "overlay player starting"
            ;;
        *"Connection timed out"*)
            toggle_timeouts=$((toggle_timeouts + 1))
            if (( toggle_timeouts < 2 )); then
                log "overlay timeout, waiting for the next tap"
            elif [[ "$(casdap-intercept get 2>/dev/null)" == 3 ]]; then
                log "overlay timeout ${toggle_timeouts} in a row, pad held, restarting casdap-overlay.service"
                toggle_timeouts=0
                run systemctl --user restart casdap-overlay.service
            else
                log "overlay timeout ${toggle_timeouts} in a row, pad free"
            fi
            ;;
        *)
            log "failed: ToggleOverlay (rc=${rc}) ${err}"
            ;;
    esac
}

tap_overlay() {
    local tap_ms=$1 age
    if [[ -n "${tap_ms}" ]]; then
        age=$(( $(now_ms) - tap_ms ))
        if (( age >= 0 && age < 60000 )); then
            if (( tap_ms <= toggle_end_ms )); then
                log "tap during a toggle, dropped"
                return 0
            fi
            if (( age > TAP_MAX_AGE_MS )); then
                log "tap ${age} ms old, dropped"
                return 0
            fi
            log "tap ${age} ms old"
        fi
    fi
    toggle_overlay
}

show_switch_prompt() {
    local err rc=0
    if [[ "${DRY_RUN}" == 1 ]]; then
        run busctl --user call org.casdap.Player /org/casdap/Player org.casdap.Player ShowSwitchPrompt
        return 0
    fi
    err=$(busctl --user call org.casdap.Player /org/casdap/Player org.casdap.Player ShowSwitchPrompt 2>&1 >/dev/null) || rc=$?
    (( rc == 0 )) && return 0
    case "${err}" in
        *"The name is not activatable"*)
            log "no player, switching back"
            run systemctl start casdap-switch-back.service
            ;;
        *)
            log "failed: ShowSwitchPrompt (rc=${rc}) ${err}"
            ;;
    esac
}

on_tap() {
    case "$1" in
        casdap) run busctl --user call org.mpris.MediaPlayer2.casdap /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlayPause ;;
        game)
            if [[ "$(systemctl --user is-active casdap-overlay.service 2>/dev/null)" == active ]]; then
                tap_overlay "${2:-}"
            else
                log "no background player"
            fi
            ;;
        *) log "tap in ${1}, ignored" ;;
    esac
}

on_hold() {
    local now
    case "$1" in
        game)
            if title_running; then
                now=$(now_ms)
                if (( now - last_hold_ms > CONFIRM_MS )); then
                    last_hold_ms=${now}
                    log "hold ignored, title running, hold again within $((CONFIRM_MS / 1000)) s to switch"
                    return 0
                fi
            fi
            last_hold_ms=0
            run systemctl start casdap-switch.service
            ;;
        casdap)
            if [[ -e "${POWER_RUNTIME}/off" ]]; then
                log "screen off, turning it on"
                run casdap-power screen-on
            else
                show_switch_prompt
            fi
            ;;
        other)
            if plasma_running; then
                run systemctl start casdap-switch.service
            else
                log "hold in an unknown session, ignored"
            fi
            ;;
    esac
}

volume_step() {
    local line value=
    if [[ -r "${SETTINGS}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line%$'\r'}"
            [[ "${line}" == volumeStep=* ]] || continue
            value="${line#*=}"
        done < "${SETTINGS}"
    fi
    case "${value}" in
        2|5|10) printf '%s\n' "${value}" ;;
        *) printf '5\n' ;;
    esac
}

on_volume() {
    local dir=$1 value=$2 label level rest step
    if [[ "${value}" == 1 || "${dir}" != "${vol_key}" ]]; then
        vol_key=${dir}
        vol_session=$(session_state)
    fi
    [[ "${vol_session}" == casdap ]] || return 0
    step=$(volume_step)
    [[ "${dir}" == + ]] && run wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    run wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${step}%${dir}"
    read -r label level rest < <(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    if [[ "${label:-}" != Volume: || -z "${level:-}" ]]; then
        log "wpctl get-volume gave no level"
        return 0
    fi
    run busctl --user emit /org/casdap/Hotkeys org.casdap.Hotkeys VolumeChanged d "${level}"
}

main() {
    local dev vol_devs line read_result state press_ms rem session

    trap 'exit 0' INT TERM

    dev=$(wait_for_key_device) || {
        log "${DEVICE_NAME} not found after ${DEVICE_WAIT_SEC} s"
        return 0
    }
    mapfile -t vol_devs < <(volume_devices)

    log "watching ${dev} for ${KEY}, volume on ${vol_devs[*]:-none}, hold ${LONG_MS} ms, dry run ${DRY_RUN}"
    exec 3< <(event_stream "${dev}" "${vol_devs[@]}")
    state=idle
    press_ms=0
    session=

    while :; do
        read_result=0
        case "${state}" in
            held)
                rem=$((LONG_MS - ($(now_ms) - press_ms)))
                if (( rem <= 0 )); then
                    log "hold in ${session}"
                    on_hold "${session}"
                    state=draining
                    continue
                fi
                IFS= read -r -u 3 -t "$(printf '%d.%03d' $((rem / 1000)) $((rem % 1000)))" line 2>/dev/null \
                    || read_result=$?
                ;;
            *)
                IFS= read -r -u 3 line 2>/dev/null || read_result=$?
                ;;
        esac

        if (( read_result > 128 )) && [[ "${state}" == held ]]; then
            continue
        elif (( read_result != 0 )); then
            log "event stream ended"
            return 1
        fi

        case "${line}" in
            *"(${KEY}), value 1"*)
                [[ "${state}" == idle ]] || continue
                press_ms=$(now_ms)
                session=$(session_state)
                state=held
                ;;
            *"(${KEY}), value 0"*)
                case "${state}" in
                    held) on_tap "${session}" "$(event_ms "${line}")" ;;
                esac
                state=idle
                ;;
            *"(KEY_VOLUMEUP), value "[12])
                on_volume + "${line##*value }"
                ;;
            *"(KEY_VOLUMEDOWN), value "[12])
                on_volume - "${line##*value }"
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
