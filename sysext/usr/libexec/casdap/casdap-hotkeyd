#!/usr/bin/bash
set -uo pipefail

LONG_MS="${CASDAP_HOTKEYD_LONG_MS:-1000}"
POCKET_LONG_MS="${CASDAP_HOTKEYD_POCKET_LONG_MS:-500}"
CHORD_MS="${CASDAP_HOTKEYD_CHORD_MS:-500}"
CHORD_GRACE_MS="${CASDAP_HOTKEYD_CHORD_GRACE_MS:-40}"
CONFIRM_MS="${CASDAP_HOTKEYD_CONFIRM_MS:-3000}"
TAP_MAX_AGE_MS="${CASDAP_HOTKEYD_TAP_MAX_AGE_MS:-300}"
DOUBLE_MS="${CASDAP_HOTKEYD_DOUBLE_MS:-350}"
DEVICE_WAIT_SEC="${CASDAP_HOTKEYD_DEVICE_WAIT_SEC:-15}"
DEVICE_NAME="${CASDAP_HOTKEYD_DEVICE_NAME:-InputPlumber Keyboard}"
BUZZ_LEVEL="${CASDAP_HOTKEYD_BUZZ_LEVEL:-1.0}"
BUZZ_MS="${CASDAP_HOTKEYD_BUZZ_MS:-15}"
BUZZ_DOUBLE_MS="${CASDAP_HOTKEYD_BUZZ_DOUBLE_MS:-15 50 15}"
DRY_RUN="${CASDAP_HOTKEYD_DRY_RUN:-0}"
KEY="${CASDAP_HOTKEYD_KEY:-KEY_F13}"
DEV_INPUT="${CASDAP_DEV_INPUT:-/dev/input}"
SYS_INPUT="${CASDAP_SYS_INPUT:-/sys/class/input}"
GUIDE_DIR="${CASDAP_GUIDE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casdap-guide}"
POWER_RUNTIME="${CASDAP_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casdap-power}"
PATH="${PATH}:/usr/libexec/casdap"

log() { logger -t casdap-hotkeyd -- "$*"; }

now_ms() {
    local t=${EPOCHREALTIME//[!0-9]/}
    printf '%d\n' $(( 10#${t} / 1000 ))
}

event_ms() {
    local re='time ([0-9]+)\.([0-9]+),' usec
    [[ "$1" =~ ${re} ]] || return 0
    usec="${BASH_REMATCH[2]}000000"
    printf '%d\n' $(( BASH_REMATCH[1] * 1000 + 10#${usec:0:3} ))
}

anchor_ms() {
    if [[ -n "$1" ]] && (( $2 - $1 >= 0 && $2 - $1 <= 60000 )); then
        printf '%d\n' "$1"
    else
        printf '%d\n' "$2"
    fi
}

gap_ms() {
    if [[ -n "$1" && -n "$3" ]] && (( $3 - $1 >= 0 && $3 - $1 <= 60000 )); then
        printf '%d\n' $(( $3 - $1 ))
    else
        printf '%d\n' $(( $4 - $2 ))
    fi
}

run() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: $*"
        return 0
    fi
    "$@" || log "failed: $* (rc=$?)"
}

ms_sec() { printf '%d.%03d' $((10#$1 / 1000)) $((10#$1 % 1000)); }

rumble() {
    local level=$1 path
    shift
    for path in "$@"; do
        busctl --system call org.shadowblip.InputPlumber "${path}" org.shadowblip.Output.ForceFeedback Rumble d "${level}" \
            >/dev/null 2>&1 || true
    done
}

buzz() {
    if [[ "${DRY_RUN}" == 1 ]]; then
        log "would: buzz $*"
        return 0
    fi
    (
        local devs ms i=0
        mapfile -t devs < <(busctl --system tree --list org.shadowblip.InputPlumber 2>/dev/null \
            | grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$')
        (( ${#devs[@]} )) || exit 0
        trap 'rumble 0 "${devs[@]}"; exit 0' INT TERM
        for ms in "$@"; do
            [[ "${ms}" =~ ^[0-9]+$ ]] || exit 0
            if (( i % 2 == 0 )); then
                rumble "${BUZZ_LEVEL}" "${devs[@]}"
                sleep "$(ms_sec "${ms}")"
                rumble 0 "${devs[@]}"
            else
                sleep "$(ms_sec "${ms}")"
            fi
            i=$((i + 1))
        done
    ) 3<&- </dev/null >/dev/null 2>&1 &
}

key_device() {
    local dev name
    for dev in "${DEV_INPUT}"/event*; do
        [[ -e "${dev}" ]] || continue
        name=$(cat "${SYS_INPUT}/$(basename "${dev}")/device/name" 2>/dev/null) || continue
        [[ "${name}" == "$1" ]] || continue
        printf '%s\n' "${dev}"
        return 0
    done
    return 1
}

wait_for_key_device() {
    local waited=0
    while :; do
        key_device "${DEVICE_NAME}" && return 0
        (( waited >= DEVICE_WAIT_SEC )) && return 1
        sleep 1
        waited=$((waited + 1))
    done
}

session_state() {
    if systemctl --user is-active --quiet gamescope-session-plus@casdap.service; then
        echo casdap
    elif systemctl --user is-active --quiet gamescope-session-plus@steam.service; then
        echo game
    else
        echo other
    fi
}

title_running() { pgrep -f 'SteamLaunch AppId=' >/dev/null 2>&1; }

plasma_running() { pgrep -x plasmashell >/dev/null 2>&1; }

last_hold_ms=0
toggle_end_ms=0
toggle_timeouts=0
pending=0
pending_ms=0
pending_ev=
pending_read_ms=0
due=0
due_ms=0
due_ev=0
due_session=
due_release_ev=

toggle_overlay() {
    local err rc=0 start
    start=$(now_ms)
    if [[ "${DRY_RUN}" == 1 ]]; then
        run busctl --user --timeout=2 call org.casdap.Player /org/casdap/Player org.casdap.Player ToggleOverlay
        toggle_end_ms=$(now_ms)
        return 0
    fi
    err=$(busctl --user --timeout=2 call org.casdap.Player /org/casdap/Player org.casdap.Player ToggleOverlay 2>&1 >/dev/null) || rc=$?
    toggle_end_ms=$(now_ms)
    log "ToggleOverlay rc=${rc} in $((toggle_end_ms - start)) ms"
    case "${err}" in
        *"Connection timed out"*) ;;
        *) toggle_timeouts=0 ;;
    esac
    (( rc == 0 )) && return 0
    case "${err}" in
        *"The name is not activatable"*)
            log "overlay player starting"
            ;;
        *"Connection timed out"*)
            toggle_timeouts=$((toggle_timeouts + 1))
            if (( toggle_timeouts < 2 )); then
                log "overlay timeout, waiting for the next tap"
            elif [[ "$(casdap-intercept get 2>/dev/null)" == 3 ]]; then
                log "overlay timeout ${toggle_timeouts} in a row, pad held, restarting casdap-overlay.service"
                toggle_timeouts=0
                run systemctl --user restart casdap-overlay.service
            else
                log "overlay timeout ${toggle_timeouts} in a row, pad free"
            fi
            ;;
        *)
            log "failed: ToggleOverlay (rc=${rc}) ${err}"
            ;;
    esac
}

tap_overlay() {
    local tap_ms=$1 age
    if [[ -n "${tap_ms}" ]]; then
        age=$(( $(now_ms) - tap_ms ))
        if (( age >= 0 && age < 60000 )); then
            if (( tap_ms <= toggle_end_ms )); then
                log "tap during a toggle, dropped"
                return 0
            fi
            if (( age > TAP_MAX_AGE_MS )); then
                log "tap ${age} ms old, dropped"
                return 0
            fi
            log "tap ${age} ms old"
        fi
    fi
    toggle_overlay
}

show_switch_prompt() {
    local err rc=0
    if [[ "${DRY_RUN}" == 1 ]]; then
        run busctl --user call org.casdap.Player /org/casdap/Player org.casdap.Player ShowSwitchPrompt
        return 0
    fi
    err=$(busctl --user call org.casdap.Player /org/casdap/Player org.casdap.Player ShowSwitchPrompt 2>&1 >/dev/null) || rc=$?
    (( rc == 0 )) && return 0
    case "${err}" in
        *"The name is not activatable"*)
            log "no player, switching back"
            run systemctl start casdap-switch-back.service
            ;;
        *)
            log "failed: ShowSwitchPrompt (rc=${rc}) ${err}"
            ;;
    esac
}

mpris() {
    run busctl --user --timeout=2 call org.mpris.MediaPlayer2.casdap /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player "$1"
}

on_pocket_tap() {
    if (( pending )); then
        pending=0
        buzz ${BUZZ_DOUBLE_MS}
        log "double tap, next"
        mpris Next
        return 0
    fi
    pending=1
    pending_ev=$1
    pending_read_ms=$2
    pending_ms=$(( $(anchor_ms "$1" "$2") + DOUBLE_MS ))
}

flush_pending() {
    (( pending )) || return 0
    pending=0
    log "tap, play pause"
    mpris PlayPause
}

on_pocket_hold() {
    buzz "${BUZZ_MS}"
    flush_pending
    log "hold, previous"
    mpris Previous
}

on_tap() {
    case "$1" in
        casdap) mpris PlayPause ;;
        game)
            if [[ "$(systemctl --user is-active casdap-overlay.service 2>/dev/null)" == active ]]; then
                tap_overlay "${2:-}"
            else
                log "no background player"
            fi
            ;;
        *) log "tap in ${1}, ignored" ;;
    esac
}

on_hold() {
    local now
    case "$1" in
        game)
            if title_running; then
                now=$(now_ms)
                if (( now - last_hold_ms > CONFIRM_MS )); then
                    last_hold_ms=${now}
                    log "hold ignored, title running, hold again within $((CONFIRM_MS / 1000)) s to switch"
                    return 0
                fi
            fi
            last_hold_ms=0
            buzz "${BUZZ_MS}"
            run systemctl start casdap-switch.service
            ;;
        casdap)
            buzz "${BUZZ_MS}"
            show_switch_prompt
            ;;
        other)
            if plasma_running; then
                buzz "${BUZZ_MS}"
                run systemctl start casdap-switch.service
            else
                log "hold in an unknown session, ignored"
            fi
            ;;
    esac
}

guide_down() { printf '%s\n' "$1" > "${GUIDE_DIR}/down"; }

chord_taken() {
    local v=
    [[ -r "${GUIDE_DIR}/chord" ]] && read -r v < "${GUIDE_DIR}/chord"
    [[ "${v}" == "$1" ]]
}

resolve_tap() {
    guide_down 0
    if chord_taken "$1"; then
        log "chord, tap dropped"
        return 0
    fi
    log "tap, play pause"
    on_tap "$2" "$3"
}

guide_hold() {
    guide_down 0
    if (( $2 )); then
        log "hold in $1"
        on_pocket_hold
    elif [[ "$1" == casdap ]] && chord_taken "$3"; then
        log "chord, hold dropped"
    else
        log "hold in $1"
        on_hold "$1"
    fi
}

resolve_due() {
    (( due )) || return 0
    due=0
    resolve_tap "${due_ev}" "${due_session}" "${due_release_ev}"
}

main() {
    local dev line partial read_result state press_ms press_raw press_ev press_at hold_ms release_ms release_raw release_ev
    local held_for rem due_rem session pocket

    trap 'exit 0' INT TERM

    mkdir -p "${GUIDE_DIR}"
    printf '0\n' > "${GUIDE_DIR}/down"
    printf '0\n' > "${GUIDE_DIR}/chord"

    dev=$(wait_for_key_device) || {
        log "${DEVICE_NAME} not found after ${DEVICE_WAIT_SEC} s"
        return 0
    }

    log "watching ${dev} for ${KEY}, hold ${LONG_MS} ms, pocket hold ${POCKET_LONG_MS} ms, double tap ${DOUBLE_MS} ms, chord ${CHORD_MS} ms, dry run ${DRY_RUN}"
    exec 3< <(evtest "${dev}" 2>/dev/null)
    state=idle
    press_ms=0
    partial=
    press_raw=
    press_ev=0
    press_at=0
    hold_ms=${LONG_MS}
    session=
    pocket=0

    while :; do
        read_result=0
        rem=
        if [[ "${state}" == held ]]; then
            rem=$((press_at + hold_ms - $(now_ms)))
            if (( rem <= 0 )) && ! read -t 0 -u 3 2>/dev/null; then
                guide_hold "${session}" "${pocket}" "${press_ev}"
                state=draining
                continue
            fi
        else
            if (( pending )); then
                rem=$((pending_ms - $(now_ms)))
                if (( rem <= 0 )) && ! read -t 0 -u 3 2>/dev/null; then
                    flush_pending
                    continue
                fi
            fi
            if (( due )); then
                due_rem=$((due_ms - $(now_ms)))
                if (( due_rem <= 0 )) && ! read -t 0 -u 3 2>/dev/null; then
                    resolve_due
                    continue
                fi
                if [[ -z "${rem}" ]] || (( due_rem < rem )); then
                    rem=${due_rem}
                fi
            fi
        fi
        if [[ -n "${rem}" ]] && (( rem > 0 )); then
            IFS= read -r -u 3 -t "$(ms_sec "${rem}")" line 2>/dev/null || read_result=$?
        else
            IFS= read -r -u 3 line 2>/dev/null || read_result=$?
        fi

        if (( read_result > 128 )) && [[ "${state}" == held || "${pending}" == 1 || "${due}" == 1 ]]; then
            partial+=${line}
            continue
        elif (( read_result != 0 )); then
            resolve_due
            flush_pending
            log "event stream ended"
            return 1
        fi
        line=${partial}${line}
        partial=

        case "${line}" in
            *"(${KEY}), value 1"*)
                [[ "${state}" == idle ]] || continue
                resolve_due
                press_ms=$(now_ms)
                press_raw=$(event_ms "${line}")
                press_ev=${press_raw:-${press_ms}}
                press_at=$(anchor_ms "${press_raw}" "${press_ms}")
                guide_down "${press_ev}"
                if (( pending )) && (( $(gap_ms "${pending_ev}" "${pending_read_ms}" "${press_raw}" "${press_ms}") >= DOUBLE_MS )); then
                    flush_pending
                fi
                if (( ! pending )); then
                    session=$(session_state)
                    pocket=0
                    if [[ "${session}" == casdap && -e "${POWER_RUNTIME}/off" ]]; then
                        pocket=1
                    fi
                fi
                hold_ms=${LONG_MS}
                (( pocket )) && hold_ms=${POCKET_LONG_MS}
                state=held
                ;;
            *"(${KEY}), value 0"*)
                if [[ "${state}" == held ]]; then
                    release_ms=$(now_ms)
                    release_raw=$(event_ms "${line}")
                    release_ev=${release_raw}
                    held_for=$(gap_ms "${press_raw}" "${press_ms}" "${release_raw}" "${release_ms}")
                    if (( held_for >= hold_ms )); then
                        guide_hold "${session}" "${pocket}" "${press_ev}"
                    elif (( pocket )); then
                        guide_down 0
                        on_pocket_tap "${release_raw}" "${release_ms}"
                    elif [[ "${session}" == casdap ]]; then
                        release_ev=${release_ev:-${release_ms}}
                        if (( held_for < CHORD_MS )); then
                            due=1
                            due_ms=$(( $(now_ms) + CHORD_GRACE_MS ))
                            due_ev=${press_ev}
                            due_session=${session}
                            due_release_ev=${release_ev}
                        else
                            resolve_tap "${press_ev}" "${session}" "${release_ev}"
                        fi
                    else
                        guide_down 0
                        on_tap "${session}" "${release_ev}"
                    fi
                fi
                state=idle
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
