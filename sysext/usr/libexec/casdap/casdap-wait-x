#!/usr/bin/bash
set -eu

display="${DISPLAY:-:0}"
socket_dir="${CASDAP_X_SOCKET_DIR:-/tmp/.X11-unix}"
socket="${socket_dir}/X${display#:}"
limit_ms="${CASDAP_WAIT_X_MS:-20000}"
step_ms=200
waited_ms=0

while :; do
    if [[ -e "${socket}" ]] && xprop -root -display "${display}" > /dev/null 2>&1; then
        exit 0
    fi
    if (( waited_ms >= limit_ms )); then
        echo "casdap-wait-x: no X server on ${display} after ${limit_ms} ms" >&2
        exit 1
    fi
    sleep 0.2
    waited_ms=$((waited_ms + step_ms))
done
