#!/usr/bin/python3
import os
import signal
import socket
import subprocess
import sys

import dbus
import dbus.service
import gi
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

try:
    gi.require_version('GLibUnix', '2.0')
    from gi.repository import GLibUnix
    unix_signal_add = GLibUnix.signal_add
except (ImportError, ValueError, AttributeError):
    unix_signal_add = GLib.unix_signal_add

BLUEZ = 'org.bluez'
OBJECT_MANAGER = 'org.freedesktop.DBus.ObjectManager'
PROPERTIES = 'org.freedesktop.DBus.Properties'
ADAPTER = 'org.bluez.Adapter1'
DEVICE = 'org.bluez.Device1'
AGENT = 'org.bluez.Agent1'
AGENT_MANAGER = 'org.bluez.AgentManager1'
AGENT_PATH = '/net/seilent/MicroDap/agent'
SERVICE = 'net.seilent.MicroDap.Bluetooth'
SERVICE_PATH = '/net/seilent/MicroDap/Bluetooth'
BASE_UUID = '-0000-1000-8000-00805f9b34fb'
ALLOWED = {
    'receiver': ('110b', '110c', '110d', '110e'),
    'headphones': ('110a', '110c', '110d', '110e'),
}
A2DP_SOURCE = '0000110a' + BASE_UUID
A2DP_SINK = '0000110b' + BASE_UUID
SAVED = ('Pairable', 'PairableTimeout', 'DiscoverableTimeout')
MAX_TIMEOUT = 600
KEEP_BIN = os.environ.get('MICRODAP_KEEP_BIN', '/usr/libexec/microdap/microdap-keep')
KEEP_TIMEOUT = 5
DISCONNECT_TIMEOUT = 10
ONE_SHOT_TIMEOUT = 2
RESOLVE_TICKS = 10
CAPABILITY = 'NoInputNoOutput'
COMPANION_CAPABILITY = 'DisplayYesNo'


def log(message):
    print(message, file=sys.stderr, flush=True)


def keep_phone():
    try:
        result = subprocess.run([KEEP_BIN, 'check'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=KEEP_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as e:
        log(f'keep check failed: {e}')
        return False
    return result.returncode == 0


def release_phones(bus, keep, timeout=DISCONNECT_TIMEOUT, when='on exit'):
    manager = dbus.Interface(bus.get_object(BLUEZ, '/', introspect=False), OBJECT_MANAGER)
    try:
        objects = manager.GetManagedObjects(timeout=timeout)
    except dbus.DBusException as e:
        log(f'release: {e.get_dbus_name()}')
        return 1
    status = 0
    for path, interfaces in sorted(objects.items()):
        props = interfaces.get(DEVICE)
        if not props or not props.get('Connected'):
            continue
        uuids = [str(u).lower() for u in props.get('UUIDs', [])]
        if A2DP_SOURCE not in uuids:
            continue
        path = str(path)
        if keep:
            log(f'keeping {path} connected')
            continue
        try:
            device = dbus.Interface(bus.get_object(BLUEZ, path, introspect=False), DEVICE)
            device.Disconnect(timeout=timeout)
            log(f'disconnected {path} {when}')
        except dbus.DBusException as e:
            log(f'disconnect {path} failed: {e.get_dbus_name()}')
            status = 1
    return status


def system_bus():
    address = os.environ.get('MICRODAP_BT_SYSTEM_BUS')
    return dbus.bus.BusConnection(address) if address else dbus.SystemBus()


class Rejected(dbus.DBusException):
    _dbus_error_name = 'org.bluez.Error.Rejected'


class InvalidArgs(dbus.DBusException):
    _dbus_error_name = 'org.freedesktop.DBus.Error.InvalidArgs'


def short_uuid(uuid):
    uuid = str(uuid).lower()
    if len(uuid) == 36 and uuid.startswith('0000') and uuid.endswith(BASE_UUID):
        return uuid[4:8]
    return uuid


class Adapter:
    def __init__(self, bus):
        self.bus = bus
        self.path = self.find()
        obj = bus.get_object(BLUEZ, self.path, introspect=False)
        self.properties = dbus.Interface(obj, PROPERTIES)
        self.adapter = dbus.Interface(obj, ADAPTER)

    def find(self):
        manager = dbus.Interface(self.bus.get_object(BLUEZ, '/', introspect=False), OBJECT_MANAGER)
        for path, interfaces in sorted(manager.GetManagedObjects().items()):
            if ADAPTER in interfaces:
                return str(path)
        raise RuntimeError('no bluetooth adapter')

    def get(self, name):
        return self.properties.Get(ADAPTER, name)

    def set(self, name, value):
        try:
            self.properties.Set(ADAPTER, name, value, signature='ssv')
        except dbus.DBusException as e:
            log(f'set {name} failed: {e.get_dbus_name()}')

    def paired(self):
        manager = dbus.Interface(self.bus.get_object(BLUEZ, '/', introspect=False), OBJECT_MANAGER)
        try:
            objects = manager.GetManagedObjects()
        except dbus.DBusException as e:
            log(f'paired list: {e.get_dbus_name()}')
            return set()
        return {str(path) for path, interfaces in objects.items()
                if interfaces.get(DEVICE, {}).get('Paired')}

    def name_of(self, path):
        try:
            obj = self.bus.get_object(BLUEZ, path, introspect=False)
            props = dbus.Interface(obj, PROPERTIES).GetAll(DEVICE)
        except dbus.DBusException:
            return ''
        return str(props.get('Alias') or props.get('Name') or '')

    def discovery(self, on):
        try:
            if on:
                self.adapter.SetDiscoveryFilter(dbus.Dictionary({'Transport': dbus.String('bredr')}, signature='sv'))
                self.adapter.StartDiscovery()
            else:
                self.adapter.StopDiscovery()
        except dbus.DBusException as e:
            log(f'discovery {"start" if on else "stop"} failed: {e.get_dbus_name()}')

    def remove_device(self, path):
        try:
            self.adapter.RemoveDevice(dbus.ObjectPath(path))
        except dbus.DBusException as e:
            log(f'remove {path} failed: {e.get_dbus_name()}')


class Window(dbus.service.Object):
    def __init__(self, bus, adapter):
        super().__init__(bus, SERVICE_PATH)
        self.adapter = adapter
        self.mode = None
        self.role = 'receiver'
        self.remaining = 0
        self.saved = None
        self.timer = None
        self.bonded = set()
        self.removing = set()
        self.held = None
        self.approved = None
        self.resolve = 0
        self.manager = None

    @property
    def active(self):
        return self.mode is not None

    def values(self):
        pairing = self.mode in ('pairing', 'companion')
        search = self.mode == 'search'
        held = self.held or {}
        return {
            'PairingActive': dbus.Boolean(pairing),
            'PairingRemaining': dbus.UInt32(self.remaining if pairing else 0),
            'PairingMode': dbus.String('companion' if self.mode == 'companion' else 'audio' if pairing else ''),
            'SearchActive': dbus.Boolean(search),
            'SearchRemaining': dbus.UInt32(self.remaining if search else 0),
            'Role': dbus.String(self.role),
            'ConfirmPending': dbus.Boolean(self.held is not None),
            'ConfirmPasskey': dbus.UInt32(held.get('passkey', 0)),
            'ConfirmName': dbus.String(held.get('name', '')),
            'CompanionKnown': dbus.Array(sorted(self.known()), signature='o'),
            'CompanionRemoving': dbus.Array(sorted(self.removing), signature='o'),
        }

    def known(self):
        if self.mode != 'companion':
            return set()
        return self.bonded | ({self.approved} if self.approved else set())

    def remove(self, path):
        self.removing.add(path)
        self.notify('CompanionRemoving')

    def removed(self, path):
        if path in self.removing:
            self.removing.discard(path)
            self.notify('CompanionRemoving')

    def names(self, mode):
        if mode in ('pairing', 'companion'):
            return ('PairingActive', 'PairingRemaining', 'PairingMode')
        return ('SearchActive', 'SearchRemaining')

    def capability(self, capability):
        if self.manager is None:
            return
        try:
            self.manager.UnregisterAgent(dbus.ObjectPath(AGENT_PATH))
            self.manager.RegisterAgent(dbus.ObjectPath(AGENT_PATH), dbus.String(capability))
            self.manager.RequestDefaultAgent(dbus.ObjectPath(AGENT_PATH))
        except dbus.DBusException as e:
            log(f'agent capability {capability} failed: {e.get_dbus_name()}')

    def notify(self, *names):
        values = self.values()
        changed = dbus.Dictionary({name: values[name] for name in names}, signature='sv')
        self.PropertiesChanged(SERVICE, changed, dbus.Array([], signature='s'))

    @dbus.service.signal(PROPERTIES, signature='sa{sv}as')
    def PropertiesChanged(self, interface, changed, invalidated):
        pass

    @dbus.service.method(PROPERTIES, in_signature='ss', out_signature='v')
    def Get(self, interface, name):
        values = self.values()
        if interface != SERVICE or name not in values:
            raise InvalidArgs(f'{interface}.{name}')
        return values[name]

    @dbus.service.method(PROPERTIES, in_signature='s', out_signature='a{sv}')
    def GetAll(self, interface):
        if interface != SERVICE:
            raise InvalidArgs(interface)
        return self.values()

    @dbus.service.method(PROPERTIES, in_signature='ssv', out_signature='')
    def Set(self, interface, name, value):
        raise InvalidArgs(f'{interface}.{name} is read only')

    def checked(self, timeout):
        timeout = int(timeout)
        if timeout < 1 or timeout > MAX_TIMEOUT:
            raise InvalidArgs(f'timeout must be 1 to {MAX_TIMEOUT} seconds')
        return timeout

    def start_timer(self, timeout):
        if self.timer is not None:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(1000, self.tick)
        self.remaining = timeout

    def discoverable(self, timeout, mode):
        if self.mode is not None and self.mode != mode:
            self.close(f'closed: {mode}')
        if self.saved is None:
            self.saved = {name: self.adapter.get(name) for name in SAVED}
        self.adapter.set('PairableTimeout', dbus.UInt32(timeout))
        self.adapter.set('Pairable', dbus.Boolean(True))
        self.adapter.set('DiscoverableTimeout', dbus.UInt32(timeout))
        self.adapter.set('Discoverable', dbus.Boolean(True))
        self.adapter.set('Alias', dbus.String(socket.gethostname()))
        fresh = mode == 'companion' and self.mode != 'companion'
        if fresh:
            self.bonded = self.adapter.paired()
            self.approved = None
            self.capability(COMPANION_CAPABILITY)
        self.start_timer(timeout)
        self.mode = mode
        log(f'{"companion pairing" if mode == "companion" else "pairing"} window open for {timeout} s')
        self.notify(*self.names(mode), *(('CompanionKnown',) if fresh else ()))

    @dbus.service.method(SERVICE, in_signature='u', out_signature='')
    def StartPairing(self, timeout):
        self.discoverable(self.checked(timeout), 'pairing')

    @dbus.service.method(SERVICE, in_signature='u', out_signature='')
    def StartCompanionPairing(self, timeout):
        self.discoverable(self.checked(timeout), 'companion')

    @dbus.service.method(SERVICE, in_signature='', out_signature='')
    def StopPairing(self):
        if self.mode in ('pairing', 'companion'):
            self.close('stopped')

    @dbus.service.method(SERVICE, in_signature='ub', out_signature='')
    def AnswerConfirm(self, passkey, yes):
        held = self.held
        if held is None:
            return
        if int(passkey) != held['passkey']:
            log(f'companion answer for {int(passkey):06d} ignored, holding {held["passkey"]:06d}')
            return
        self.held = None
        if yes:
            self.approved = held['device']
            self.resolve = RESOLVE_TICKS
            log(f'companion confirm accepted {held["device"]}')
            held['ok']()
            self.notify('CompanionKnown')
        else:
            log(f'companion confirm refused {held["device"]}')
            held['err'](Rejected('confirmation refused'))
        self.notify('ConfirmPending', 'ConfirmPasskey', 'ConfirmName')
        if self.remaining <= 0 and self.resolve <= 0:
            self.close('timed out')

    @dbus.service.signal(SERVICE, signature='o')
    def CompanionPaired(self, device):
        pass

    def held_confirm(self, device, passkey, ok, err):
        if self.held is not None:
            err(Rejected('a confirmation is open'))
            return
        self.held = {'device': device, 'passkey': int(passkey), 'name': self.adapter.name_of(device),
                     'ok': ok, 'err': err}
        log(f'companion confirm {int(passkey):06d} from {device}')
        self.notify('ConfirmPending', 'ConfirmPasskey', 'ConfirmName')

    def cancel_confirm(self):
        held = self.held
        if held is None:
            return
        self.held = None
        held['err'](Rejected('cancelled'))
        self.notify('ConfirmPending', 'ConfirmPasskey', 'ConfirmName')

    def commit(self, path):
        log(f'companion paired {path}')
        self.CompanionPaired(dbus.ObjectPath(path))
        self.close(f'closed: phone app paired {path}')

    @dbus.service.method(SERVICE, in_signature='u', out_signature='')
    def StartSearch(self, timeout):
        timeout = self.checked(timeout)
        if self.mode in ('pairing', 'companion'):
            self.close('closed: search')
        if self.mode is None:
            self.saved = {name: self.adapter.get(name) for name in SAVED}
            self.adapter.set('PairableTimeout', dbus.UInt32(timeout))
            self.adapter.set('Pairable', dbus.Boolean(True))
            self.adapter.discovery(True)
        self.start_timer(timeout)
        self.mode = 'search'
        log(f'search window open for {timeout} s')
        self.notify('SearchActive', 'SearchRemaining')

    @dbus.service.method(SERVICE, in_signature='', out_signature='')
    def StopSearch(self):
        if self.mode == 'search':
            self.close('stopped')

    @dbus.service.method(SERVICE, in_signature='s', out_signature='')
    def SetRole(self, role):
        role = str(role)
        if role not in ALLOWED:
            raise InvalidArgs(f'role must be one of {", ".join(ALLOWED)}')
        if role == self.role:
            return
        self.role = role
        log(f'role {role}')
        self.notify('Role')

    def tick(self):
        if self.resolve > 0:
            self.resolve -= 1
        deferred = self.held is not None or self.resolve > 0
        if self.remaining > 0:
            self.remaining -= 1
            if self.remaining > 0 or deferred:
                self.notify(self.names(self.mode)[1])
                return True
        if deferred:
            return True
        self.timer = None
        self.close('timed out')
        return False

    def close(self, reason):
        if not self.active:
            return
        self.cancel_confirm()
        mode = self.mode
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None
        self.mode = None
        self.remaining = 0
        self.bonded = set()
        self.approved = None
        self.resolve = 0
        if mode == 'companion':
            self.notify('CompanionKnown')
        if mode == 'companion':
            self.capability(CAPABILITY)
        for name, value in self.saved.items():
            self.adapter.set(name, value)
        self.saved = None
        if mode in ('pairing', 'companion'):
            self.adapter.set('Discoverable', dbus.Boolean(False))
        else:
            self.adapter.discovery(False)
        log(f'{mode} window {reason}')
        self.notify(*self.names(mode))


def kind(uuids):
    uuids = [str(u).lower() for u in uuids]
    if A2DP_SOURCE in uuids:
        return 'phone'
    if A2DP_SINK in uuids:
        return 'headset'
    return None


class Agent(dbus.service.Object):
    def __init__(self, bus, window):
        super().__init__(bus, AGENT_PATH)
        self.bus = bus
        self.window = window

    def device_kind(self, device):
        try:
            obj = self.bus.get_object(BLUEZ, str(device), introspect=False)
            uuids = [str(u).lower() for u in dbus.Interface(obj, PROPERTIES).Get(DEVICE, 'UUIDs')]
        except dbus.DBusException:
            return None
        if (A2DP_SOURCE in uuids) == (A2DP_SINK in uuids):
            return None
        return 'phone' if A2DP_SOURCE in uuids else 'headset'

    def reject(self, what, device):
        log(f'Rejected {what} {device}')
        return Rejected(f'{what} rejected')

    def gate(self, what, device):
        if not self.window.active:
            raise self.reject(what, device)
        log(f'accepted {what} {device}')

    @dbus.service.method(AGENT, in_signature='', out_signature='')
    def Release(self):
        log('agent released')

    @dbus.service.method(AGENT, in_signature='o', out_signature='s')
    def RequestPinCode(self, device):
        raise self.reject('RequestPinCode', device)

    @dbus.service.method(AGENT, in_signature='os', out_signature='')
    def DisplayPinCode(self, device, pincode):
        raise self.reject('DisplayPinCode', device)

    @dbus.service.method(AGENT, in_signature='o', out_signature='u')
    def RequestPasskey(self, device):
        raise self.reject('RequestPasskey', device)

    @dbus.service.method(AGENT, in_signature='ouq', out_signature='')
    def DisplayPasskey(self, device, passkey, entered):
        raise self.reject('DisplayPasskey', device)

    @dbus.service.method(AGENT, in_signature='ou', out_signature='', async_callbacks=('ok', 'err'))
    def RequestConfirmation(self, device, passkey, ok, err):
        if self.window.mode == 'companion':
            self.window.held_confirm(str(device), passkey, ok, err)
            return
        try:
            self.gate('RequestConfirmation', device)
        except dbus.DBusException as e:
            err(e)
            return
        ok()

    @dbus.service.method(AGENT, in_signature='o', out_signature='')
    def RequestAuthorization(self, device):
        if self.window.mode == 'companion':
            raise self.reject('RequestAuthorization', device)
        self.gate('RequestAuthorization', device)

    @dbus.service.method(AGENT, in_signature='os', out_signature='')
    def AuthorizeService(self, device, uuid):
        role = self.window.role
        wrong = 'headset' if role == 'receiver' else 'phone'
        if short_uuid(uuid) in ALLOWED[role] and self.device_kind(device) != wrong:
            log(f'authorized {uuid} {device}')
            return
        raise self.reject(str(uuid), device)

    @dbus.service.method(AGENT, in_signature='', out_signature='')
    def Cancel(self):
        log('request cancelled')
        self.window.resolve = 0
        self.window.cancel_confirm()


class Gate:
    def __init__(self, bus, adapter, window):
        self.bus = bus
        self.adapter = adapter
        self.window = window
        self.pending = set()
        self.searched = set()
        bus.add_signal_receiver(self.changed, bus_name=BLUEZ, dbus_interface=PROPERTIES,
                                signal_name='PropertiesChanged', arg0=DEVICE, path_keyword='path')

    def changed(self, interface, changed, invalidated, path=None):
        path = str(path)
        if 'Paired' in changed and not changed['Paired']:
            self.pending.discard(path)
            self.searched.discard(path)
            self.window.removed(path)
        if changed.get('Paired') and self.window.mode == 'search':
            self.searched.add(path)
        if changed.get('Paired') or (path in self.pending and changed.get('ServicesResolved')):
            self.check(path)
        elif changed.get('Connected') and self.window.mode == 'pairing':
            self.connected(path)

    def connected(self, path):
        try:
            obj = self.bus.get_object(BLUEZ, path, introspect=False)
            props = dbus.Interface(obj, PROPERTIES).GetAll(DEVICE)
        except dbus.DBusException as e:
            log(f'gate {path}: {e.get_dbus_name()}')
            return
        uuids = [str(u).lower() for u in props.get('UUIDs', [])]
        if props.get('Paired') and A2DP_SOURCE in uuids:
            log(f'connected {path}')
            self.window.close(f'closed: connected {path}')

    def check(self, path):
        try:
            obj = self.bus.get_object(BLUEZ, path, introspect=False)
            props = dbus.Interface(obj, PROPERTIES).GetAll(DEVICE)
        except dbus.DBusException as e:
            self.pending.discard(path)
            log(f'gate {path}: {e.get_dbus_name()}')
            return
        if not props.get('Paired'):
            self.pending.discard(path)
            self.searched.discard(path)
            return
        if self.window.mode == 'companion':
            self.pending.discard(path)
            if path == self.window.approved:
                self.window.commit(path)
            elif path not in self.window.bonded:
                log(f'removing {path}, window not approved')
                self.window.remove(path)
                self.adapter.remove_device(path)
                self.window.removed(path)
            return
        if not props.get('ServicesResolved'):
            self.pending.add(path)
            return
        self.pending.discard(path)
        searched = path in self.searched
        self.searched.discard(path)
        found = kind(props.get('UUIDs', []))
        if found == 'phone':
            log(f'paired {path}')
            if self.window.mode == 'pairing':
                self.window.close(f'closed: paired {path}')
            return
        if found == 'headset' and searched:
            log(f'paired headset {path}')
            return
        log(f'removing {path}, no a2dp source')
        self.adapter.remove_device(path)


def disconnect_sources():
    try:
        bus = system_bus()
    except dbus.DBusException as e:
        log(f'release: {e.get_dbus_name()}')
        return 1
    return release_phones(bus, False, ONE_SHOT_TIMEOUT, 'on close')


def main():
    if sys.argv[1:] == ['--print-keep']:
        print('keep' if keep_phone() else 'drop')
        return 0
    if sys.argv[1:] == ['--disconnect-sources']:
        return disconnect_sources()
    DBusGMainLoop(set_as_default=True)
    system = system_bus()
    session = dbus.SessionBus()
    adapter = Adapter(system)
    pairable = adapter.get('Pairable')
    adapter.set('Discoverable', dbus.Boolean(False))
    window = Window(session, adapter)
    Agent(system, window)
    Gate(system, adapter, window)
    manager = dbus.Interface(system.get_object(BLUEZ, '/org/bluez', introspect=False), AGENT_MANAGER)
    manager.RegisterAgent(dbus.ObjectPath(AGENT_PATH), dbus.String(CAPABILITY))
    manager.RequestDefaultAgent(dbus.ObjectPath(AGENT_PATH))
    window.manager = manager
    adapter.set('Pairable', dbus.Boolean(False))
    name = dbus.service.BusName(SERVICE, session)
    loop = GLib.MainLoop()
    status = [0]

    def stop(*_):
        window.close('closed on exit')
        release_phones(system, keep_phone())
        adapter.set('Pairable', pairable)
        session.flush()
        loop.quit()
        return GLib.SOURCE_REMOVE

    def owner_changed(owner):
        if owner:
            return
        log('org.bluez left the bus')
        status[0] = 1
        window.close('bluez left')
        session.flush()
        loop.quit()

    unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, stop)
    unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, stop)
    system.watch_name_owner(BLUEZ, owner_changed)
    log(f'agent registered on {adapter.path} as {name.get_name()}')
    loop.run()
    return status[0]


if __name__ == '__main__':
    sys.exit(main())
